<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\KefRemote.Core\KefRemote.Core.csproj" />
    <ProjectReference Include="..\..\src\KefRemote.Drivers\KefRemote.Drivers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Platform-neutral hotkey logic from the Windows app, compiled in so it is tested on every OS. -->
    <Compile Include="..\..\src\KefRemote.Windows\Hotkeys\HotkeyBinding.cs" Link="Windows\HotkeyBinding.cs" />
    <Compile Include="..\..\src\KefRemote.Windows\Hotkeys\VolumeKeyAccumulator.cs" Link="Windows\VolumeKeyAccumulator.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\spec\test-vectors\*.json" Link="vectors\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
